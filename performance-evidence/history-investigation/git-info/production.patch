+    ) -> anyhow::Result<(String, HashSet<Utf8PathBuf>)> {
+        let output = self.git(&["show", "--name-only", "--pretty=format:%B%x00"])?;
+        let (message, files) = output
+            .split_once('\0')
+            .context("missing separator between commit message and files")?;
+        let changed_files = files
